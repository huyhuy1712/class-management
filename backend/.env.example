DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FULL_NAME=
ADMIN_PHONE=

# Local development: Spring Email via SMTP
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=your-email@gmail.com
# SMTP emails are stored in the database outbox and sent asynchronously.
MAIL_OUTBOX_POLL_DELAY_MS=3000


# Google OAuth (local; configure an OAuth 2.0 Web Client in Google Cloud Console)
# Set GOOGLE_OAUTH_ENABLED=true after filling in the client credentials below.
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
# Local Google authorized redirect URI:
# http://localhost:8080/login/oauth2/code/google

# MoMo sandbox
# Keep MOMO_ENABLED=false until all credentials and the public IPN URL are ready.
MOMO_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Must be publicly reachable by MoMo, for example through ngrok/Cloudflare Tunnel.
MOMO_IPN_URL=https://your-public-backend.example.com/api/billing/momo/ipn


GROK_API_KEY=

AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_BASE_URL=http://localhost:8080
