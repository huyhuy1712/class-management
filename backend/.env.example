# Local development: Spring Email via SMTP
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=your-email@gmail.com

# Production: Mailjet HTTPS API (set these in the Railway backend service)
MAIL_PROVIDER=https
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_API_URL=https://api.mailjet.com/v3.1/send
MAIL_FROM=FrogH <sender-verified-in-Mailjet@example.com>


